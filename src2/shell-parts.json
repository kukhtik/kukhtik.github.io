span class=\"own-pill own-pill--b\">{{SLOT:pill.facts}}</span>\n          <span class=\"own-pill own-pill--r\">{{SLOT:pill.accuracy}}</span>\n          <span class=\"own-pill\">{{SLOT:pill.latency}}</span>\n          <span class=\"own-pill own-pill--o\">{{SLOT:pill.tests}}</span>\n        </div>\n\n        <div class=\"own-readout\">\n          <div class=\"own-readout__row\"><span>{{SLOT:casc.clock.label}}</span><b data-cascade=\"clock\"></b></div>\n          <div class=\"own-readout__row\"><span>{{SLOT:casc.date.label}}</span><b data-cascade=\"date\"></b></div>\n          <div class=\"own-readout__row\"><span>{{SLOT:casc.days.label}}</span><b data-cascade=\"days\"></b></div>\n          <div class=\"own-readout__row\"><span>{{SLOT:casc.uptime.label}}</span><b data-cascade=\"uptime\"></b></div>\n          <div class=\"own-readout__row\"><span>{{SLOT:casc.index.label}}</span><b data-cascade=\"index\"></b></div>\n        </div>\n\n        <div class=\"lcars-text-bar\" id=\"sec-build\"><h3>What I build</h3></div>\n\n        <div class=\"own-svc\">\n          <div class=\"own-svc__row\" data-block=\"service.01\">\n            <span class=\"own-svc__n\">{{SLOT:service.01.number}}</span>\n            <div><h3>{{SLOT:service.01.title}}</h3><p>{{SLOT:service.01.text}}</p></div>\n          </div>\n          <div class=\"own-svc__row\" data-block=\"service.02\">\n            <span class=\"own-svc__n\">{{SLOT:service.02.number}}</span>\n            <div><h3>{{SLOT:service.02.title}}</h3><p>{{SLOT:service.02.text}}</p></div>\n          </div>\n          <div class=\"own-svc__row\" data-block=\"service.03\">\n            <span class=\"own-svc__n\">{{SLOT:service.03.number}}</span>\n            <div><h3>{{SLOT:service.03.title}}</h3><p>{{SLOT:service.03.text}}</p></div>\n          </div>\n        </div>\n\n        <div class=\"lcars-text-bar\" id=\"sec-work\"><h3>Selected work</h3></div>\n\n          <article class=\"own-project own-project--violet\" data-project=\"engineer-compa